<Project Sdk="Microsoft.NET.Sdk">

  <!--
    dotnet test runs these tests against the net10.0 library.
    dotnet test -p:LibraryTarget=netstandard2.0 runs the same tests against the netstandard2.0
    library on the .NET 10 runtime. dotnet test -p:LibraryTarget=net8.0 builds the tests for net8.0
    too, so they run on the .NET 8 runtime against the net8.0 library. That build gets its own bin and obj folders so the two
    library assets are never copied over each other, and AssetTests fails if the wrong one loaded.
  -->

  <PropertyGroup>
    <TargetFramework Condition="'$(LibraryTarget)' == 'net8.0'">net8.0</TargetFramework>
    <TargetFramework Condition="'$(LibraryTarget)' != 'net8.0'">net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <!-- Signed so the library's InternalsVisibleTo applies; the oracles it references are not strong-named. -->
    <NoWarn>$(NoWarn);CS8002</NoWarn>
    <LibraryTarget Condition="'$(LibraryTarget)' == ''">net10.0</LibraryTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LibraryTarget)' != 'net10.0'">
    <OutputPath>bin\$(Configuration)-$(LibraryTarget)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)-$(LibraryTarget)\</IntermediateOutputPath>
  </PropertyGroup>

  <!-- The SIMD bodies are compiled into the net8.0 and net10.0 assets only, the SVE2 body into net10.0. -->
  <PropertyGroup Condition="'$(LibraryTarget)' != 'netstandard2.0'">
    <DefineConstants>$(DefineConstants);LIBRARY_BODIES</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LibraryTarget)' == 'net10.0'">
    <DefineConstants>$(DefineConstants);LIBRARY_SVE2</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LibraryTarget</_Parameter1>
      <_Parameter2>$(LibraryTarget)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- Differential oracles. The known-answer files outrank all three. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <!-- NSec 26 needs .NET 9; 25.4.0 is the last release for .NET 8 and runs the same libsodium checks. -->
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageReference Include="NSec.Cryptography" Version="25.4.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The generator's set builder and pinned list, to rebuild the common-password data and compare. -->
  <ItemGroup>
    <Compile Include="..\Argon2DotnetFast.CommonPasswords.Generator\CommonPasswordSet.cs" Link="CommonPasswordSet.cs" />
    <None Include="..\Argon2DotnetFast.CommonPasswords.Generator\data\xato-net-10-million-passwords-10000.txt"
          Link="data\xato-net-10-million-passwords-10000.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Argon2DotnetFast\Argon2DotnetFast.csproj"
                      SetTargetFramework="TargetFramework=$(LibraryTarget)" />
  </ItemGroup>

</Project>
