<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Writes src/Argon2DotnetFast/Internal/CommonPasswordData.g.cs from the pinned list in data/.
    README.md gives the command that runs it. It hashes through the library's own internal code, so the two cannot disagree. Not packed.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Argon2DotnetFast\Argon2DotnetFast.csproj"
                      SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>

</Project>
