<Project>
  <!--
    Every project is signed with the same key, so the library's InternalsVisibleTo lines resolve:
    the SDK adds $(PublicKey) to each one. The key is public on purpose; a strong name is an
    identity for .NET Framework binding, not a signature anyone should trust.
  -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Argon2DotnetFast.snk</AssemblyOriginatorKeyFile>
    <PublicKey></PublicKey>
  </PropertyGroup>

  <!--
    GitHub Actions sets CI=true, and only those builds are fully signed. A strong-name signature is
    RSA over SHA-1, which OpenSSL refuses under Fedora's and RHEL's crypto policy, so local builds
    are public-signed: the same identity and token, with no signature computed.
  -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CI)' != 'true'">
    <PublicSign>true</PublicSign>
  </PropertyGroup>
</Project>
