<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>

    <!-- The version comes from the latest vX.Y.Z tag. Untagged commits build as 1.0.0-alpha.0.N. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>

    <PackageId>Argon2DotnetFast</PackageId>
    <Title>Argon2 password hashing for .NET</Title>
    <Description>Argon2id, Argon2i and Argon2d (RFC 9106) in managed C#, with AVX-512, AVX2, NEON and SVE2 compression chosen at run time and no native library. PHC strings with bounded verification and NeedsRehash, secret and associated data, any tag length, and a reusable hasher that keeps its memory and lane threads between calls. Targets .NET 10, .NET 8 and .NET Standard 2.0.</Description>
    <Authors>Marius Vitkevičius</Authors>
    <Copyright>Copyright (c) 2026 Marius Vitkevičius</Copyright>
    <PackageTags>argon2;argon2id;argon2i;argon2d;password;password-hashing;kdf;rfc9106;phc;cryptography;simd;avx512;neon;managed</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Dissimilis/Argon2DotnetFast</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Dissimilis/Argon2DotnetFast</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- The last release on nuget.org. Pack fails on an API break against it. -->
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <!-- .NET 8's reference assembly gives AdvSimd.ShiftRightLogical on 64-bit lanes a 1-16 range; the
       instruction takes 1-64, and .NET 10 declares that. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <NoWarn>$(NoWarn);CA1857</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Argon2DotnetFast.Tests" />
    <InternalsVisibleTo Include="Argon2DotnetFast.Benchmarks" />
    <InternalsVisibleTo Include="Argon2DotnetFast.CommonPasswords.Generator" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../img/icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
  <!-- Build time only: the package itself depends on nothing on net8.0 and net10.0. -->
  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
